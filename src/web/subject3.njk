{# Header của trang #}
<header class="text-center mb-4 flex-shrink-0">
    <h1 class="text-2xl font-bold dark:text-white text-gray-800">{{ title }}</h1>
</header>

{# Wrapper cho Iframe #}
<div class="flex-grow rounded-lg overflow-hidden border border-white/20">
    <iframe id="googleSheet" class="w-full h-full bg-white"></iframe>
</div>

{# Script inline để điều khiển iframe này, và chỉ iframe này #}
<script>
    const iframe = document.getElementById('googleSheet');
    const encodedURL = "{{ iframe_b64 }}";
    
    if (iframe && encodedURL) {
        try {
            iframe.src = atob(encodedURL);
        } catch (e) {
            console.error("Lỗi Base64:", e);
            iframe.style.display = 'none'; // Ẩn iframe nếu có lỗi
        }
    }
</script>