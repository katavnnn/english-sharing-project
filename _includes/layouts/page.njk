<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    {% include "head.njk" %}
</head>
<body class="antialiased text-gray-800 dark:text-white transition-colors duration-500 aurora-dark">

    <div class="flex flex-col items-center justify-center min-h-screen w-full p-4 sm:p-6 relative">
    
        <!-- Nút Quay Về Trang Chủ -->
        <a href="{{ '/' | url }}" 
           class="absolute top-4 left-4 md:top-6 md-left-6 z-20 ..." 
           aria-label="Quay về trang chủ"
           data-aos="fade-right">
            <i class="fa-solid fa-arrow-left text-lg"></i>
        </a>

        <!-- Card Kính Mờ chính chứa nội dung của trang con -->
        <div 
            class="w-full h-[85vh] max-w-5xl ... flex flex-col p-6"
            data-aos="zoom-in"
        >
            {{ content | safe }}
        </div> 
        {# Dòng này là thẻ đóng của Card Kính Mờ #}


        <!-- ======================= THÊM BANNER VÀO ĐÂY ======================= -->
        {# 
          Kiểm tra xem URL của trang hiện tại có phải là trang donate không.
          Nếu KHÔNG PHẢI, thì hiển thị banner.
        #}
        {% if page.url !== ('/web/donate/' | url) %}
            {% include "donate-banner.njk" %}
        {% endif %}
        <!-- ==================================================================== -->
        
    </div>

    <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script src="{{ '/assets/js/main.js' | url }}" type="module"></script>
</body>
</html>